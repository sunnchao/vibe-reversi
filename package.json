{
  "name": "vibe-reversi",
  "version": "1.0.0",
  "description": "《技能黑白棋 · 翻盘棋》微信小游戏 (TypeScript + 原生 Canvas 2D + 云开发)",
  "scripts": {
    "build": "esbuild src/game.ts --bundle --outfile=game.js --format=iife --target=es2020 && esbuild cloudfunctions/reversiRoom/index.ts --bundle --outfile=cloudfunctions/reversiRoom/index.js --platform=node --target=node16",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/core.test.ts",
    "test:skills": "vitest run tests/skills.test.ts",
    "test:ai": "vitest run tests/ai.test.ts",
    "test:net": "vitest run tests/net.test.ts",
    "test:ui": "vitest run tests/ui.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "esbuild": "^0.20.0",
    "typescript": "^5.3.3",
    "vitest": "^1.3.1"
  }
}
