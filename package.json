{
  "name": "vibe-reversi",
  "version": "1.0.0",
  "description": "翻盘棋 · uni-app / Vue 3 / TypeScript，支持微信小程序与 H5",
  "scripts": {
    "dev": "npm run dev:h5",
    "dev:h5": "node scripts/uni.mjs dev h5 --host 0.0.0.0 --port 5173",
    "dev:mp-weixin": "node scripts/uni.mjs dev mp-weixin",
    "preview:h5": "node scripts/uni.mjs preview h5",
    "build:h5": "node scripts/uni.mjs build h5",
    "build:mp-weixin": "node scripts/uni.mjs build mp-weixin",
    "build:uniapp": "npm run build:h5 && npm run build:mp-weixin",
    "typecheck:uniapp": "vue-tsc --noEmit -p uniapp/tsconfig.json",
    "test:uniapp": "vitest run tests/uniapp.test.ts tests/uniapp-navigation.test.ts",
    "design:import": "node scripts/import-opendesign.mjs",
    "build": "node scripts/build.mjs",
    "build:wechat": "node scripts/uni.mjs build mp-weixin",
    "build:wechat:legacy": "node scripts/build.mjs --wechat",
    "wechat:open": "node scripts/wechat-project.mjs open",
    "wechat:preview": "node scripts/wechat-project.mjs preview",
    "wechat:cloud": "node scripts/wechat-project.mjs deploy-cloud",
    "wechat:upload": "node scripts/wechat-project.mjs upload",
    "wechat:validate": "node scripts/validate-wechat-release.mjs",
    "test:wechat-release": "vitest run tests/wechat-release.test.ts",
    "preview": "npm run build && node dist/preview-server.cjs",
    "sounds:generate": "python3 scripts/generate_sounds.py",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:core": "vitest run tests/core.test.ts",
    "test:skills": "vitest run tests/skills.test.ts",
    "test:ai": "vitest run tests/ai.test.ts",
    "test:net": "vitest run tests/net.test.ts",
    "test:ui": "vitest run tests/ui.test.ts",
    "test:preview": "vitest run tests/preview.test.ts",
    "test:audio": "vitest run tests/audio.test.ts"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/vite-plugin-uni": "3.0.0-alpha-5030620261112001",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "^20.11.0",
    "@vue/runtime-core": "3.4.21",
    "culori": "4.0.2",
    "esbuild": "^0.20.0",
    "estree-walker": "2.0.2",
    "typescript": "^5.3.3",
    "vite": "5.2.8",
    "vitest": "^1.3.1",
    "vue-tsc": "2.2.12"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-components": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-h5": "3.0.0-alpha-5030620261112001",
    "@dcloudio/uni-mp-weixin": "3.0.0-alpha-5030620261112001",
    "vue": "3.4.21"
  }
}
