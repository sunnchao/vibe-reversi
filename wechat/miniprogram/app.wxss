page { height: 100%; overflow: hidden; background: #e9e3d4; }
.game-page { position: relative; width: 100%; height: 100%; }
.game-canvas { width: 100%; height: 100%; display: block; }
.native-share {
  position: absolute; bottom: 12px; right: 16px; z-index: 5;
  padding: 0 16px; line-height: 34px; min-width: 74px;
  font-size: 13px; color: #fffaf0; background: #244d3e; border-radius: 5px;
}
.native-share::after { border: 0; }
