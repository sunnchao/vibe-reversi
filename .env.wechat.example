# New uni-app frontend: copy this file to .env.local and fill in your own IDs.
# npm run dev:mp-weixin / build:mp-weixin load it with Vite loadEnv.
# Existing shell variables override .env files. Real .env files are gitignored.
# Leave both values empty to compile a complete tourist project.
# DevTools may still require a real AppID to open it; cloud play needs both IDs.
WECHAT_APPID=
WECHAT_CLOUD_ENV=

# WECHAT_APPID: the real mini-program AppID from your WeChat account.
# WECHAT_CLOUD_ENV: a Cloud Development environment bound to that AppID.
# These IDs are included in the build. Never put AppSecret, private keys or
# access tokens here. Setting IDs does not deploy or validate cloud functions.
# After changing either ID, restart dev or rebuild the mini-program.

# Legacy Canvas scripts only: these scripts read exported shell variables.
# To use this file with them: set -a; source .env.local; set +a
# Optional path to the WeChat DevTools CLI (macOS default is auto-detected).
# WECHAT_DEVTOOLS_CLI=/Applications/wechatwebdevtools.app/Contents/MacOS/cli
# Required only for the legacy `npm run wechat:upload` command.
WECHAT_UPLOAD_VERSION=1.0.0
WECHAT_UPLOAD_DESC="翻盘棋 Canvas 旧版"
